# Free local AI triage with Ollama (no OpenAI API key required)
TRIAGE_BACKEND=ollama
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional: protect the dashboard API
# TESTSENTRY_API_KEY=change-me

# Optional: Langfuse observability
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: email notifications
# EMAIL_FROM=
# EMAIL_PASSWORD=
# EMAIL_TO=
